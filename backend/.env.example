# ═══════════════════════════════════════════════════════════════════════════
# ENT Prep — Production Config
# ═══════════════════════════════════════════════════════════════════════════
# Скопируй в .env и заполни перед деплоем.

# ── Django ────────────────────────────────────────────────────────────────
SECRET_KEY=сгенерируй-надёжный-ключ-для-продакшена  # обязателен при DEBUG=False
DEBUG=False
ALLOWED_HOSTS=твой-домен.onrender.com  # обязателен при DEBUG=False

# ── Database ──────────────────────────────────────────────────────────────
# Render автоматически подставит DATABASE_URL. Локально оставь пустым (SQLite).
DATABASE_URL=

# ── CORS ──────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://твой-домен.onrender.com

# ── CSRF (обязателен для продакшна) ──────────────────────────────────────
CSRF_TRUSTED_ORIGINS=https://твой-домен.onrender.com

# ── HTTPS ─────────────────────────────────────────────────────────────────
SECURE_SSL_REDIRECT=True

# ── Sentry (мониторинг ошибок) ───────────────────────────────────────────
SENTRY_DSN=

# ── Google Forms API ──────────────────────────────────────────────────────
# Сервис-аккаунт Google Cloud (Forms API + Drive API).
# JSON-ключ положить рядом (НЕ коммитить!) и указать путь здесь.
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json


# GEMINI_API_KEY=AIza...
# HF_API_TOKEN=hf_...  # Hugging Face токен (бесплатно, ускоряет AI-разбор)
