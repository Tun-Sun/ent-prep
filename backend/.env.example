# ═══════════════════════════════════════════════════════════════════════════
# ENT Prep — Production Config
# ═══════════════════════════════════════════════════════════════════════════
# Скопируй в .env и заполни перед деплоем.

# ── Django ────────────────────────────────────────────────────────────────
SECRET_KEY=сгенерируй-надёжный-ключ-для-продакшена  # обязателен при DEBUG=False
DEBUG=False
ALLOWED_HOSTS=твой-домен.onrender.com  # обязателен при DEBUG=False

# ── Database ──────────────────────────────────────────────────────────────
# Render автоматически подставит DATABASE_URL. Локально оставь пустым (SQLite).
DATABASE_URL=

# ── CORS ──────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://твой-домен.onrender.com

# ── CSRF (обязателен для продакшна) ──────────────────────────────────────
CSRF_TRUSTED_ORIGINS=https://твой-домен.onrender.com

# ── HTTPS ─────────────────────────────────────────────────────────────────
SECURE_SSL_REDIRECT=True

# ── Sentry (мониторинг ошибок) ───────────────────────────────────────────
SENTRY_DSN=

# ── Google Forms API ──────────────────────────────────────────────────────
# Сервис-аккаунт Google Cloud (Forms API + Drive API).
# JSON-ключ положить рядом (НЕ коммитить!) и указать путь здесь.
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json


# GEMINI_API_KEY=AIza...
# HF_API_TOKEN=hf_...  # Hugging Face токен (бесплатно, ускоряет AI-разбор)

# ── GetCourse: вход из урока (SSO) ────────────────────────────────────────
# Секрет HMAC-SHA256 для подписи перехода. Пусто — эндпоинт /api/lesson/join/
# отклоняет все переходы (403), то есть без ключа вход из урока не работает.
GC_SSO_SECRET=
# Сколько секунд переход считается живым (защита от повтора клика/пересылки ссылки).
GC_SSO_MAX_AGE=300
# Домены GetCourse, которым разрешено встраивать урок в iframe, через запятую.
# Пусто — X-Frame-Options: DENY остаётся на всех страницах.
GC_FRAME_ANCESTORS=https://school.getcourse.ru
# Пути SPA, для которых снимается DENY (только урок и страница входа).
GC_FRAME_PATHS=/sso,/assignments
# Дежурный аккаунт для просмотра урока глазами ученика (кнопка «Открыть как ученик»
# и карточка предпросмотра). Войти в него даёт только верная подпись урока.
GC_DEMO_STUDENT_EMAIL=demo_student@pmci.kz

# ── GetCourse: итог урока на карточку ученика (Lesson API, Tech API v1) ─────
# Пустой токен — режим no-op: итог урока пишется в журнал LessonReport со статусом
# `skipped` и наружу не уходит. Bearer-ключ Tech API заводит админ аккаунта GetCourse
# (не путать с секретным ключом tech-api.php: тем же путём пользуется соседний
# hw-checker, и он привязан к тому же аккаунту, что и URL ниже).
GETCOURSE_API_URL=https://pmci-test.getcourse.ru/pl/api/v1
GETCOURSE_API_TOKEN=
# Числовой id доп. поля пользователя «Тренажёр: последний результат» (назван владельцем 19.10).
GC_CUSTOM_FIELD_ID=22383558

# ── Вход через Telegram (учебный чат) ───────────────────────────────────────
# Токен бота — секрет: по нему сервер проверяет подпись Telegram Login Widget.
# Пустой токен — вход через Telegram закрыт (403), а кнопка на экране не показывается.
TELEGRAM_BOT_TOKEN=
# Ник бота без `@`: его виджет подставляет в кнопку (`data-telegram-login`).
# Домен сайта обязан быть прописан боту в BotFather (/setdomain), иначе Telegram
# показывает «Username invalid» вместо кнопки.
TELEGRAM_BOT_USERNAME=
# Сколько секунд принимается ответ Telegram (Telegram советует сутки).
TELEGRAM_AUTH_MAX_AGE=86400
